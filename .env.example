# Required: your Anthropic API key
ANTHROPIC_API_KEY=

# Optional (defaults shown)
NOVA_MODEL=claude-opus-5
NOVA_EFFORT=high            # low | medium | high | xhigh | max
NOVA_MAX_TURNS=80
NOVA_SANDBOX=docker         # docker (isolated) | local (dev only, no isolation)
NOVA_DOCKER_IMAGE=python:3.11
NOVA_DOCKER_NETWORK=bridge  # set to "none" to cut the sandbox off from the internet
NOVA_DOCKER_MEMORY=4g
NOVA_DOCKER_CPUS=2
NOVA_COMMAND_TIMEOUT=300
NOVA_MAX_CONCURRENT=3
NOVA_DATA_DIR=data
NOVA_AGENT_TOKEN=           # set this before exposing the server beyond localhost
